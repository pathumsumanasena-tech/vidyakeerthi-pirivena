{
  "text": [
    {
      "key": "text.general.001",
      "section": "general",
      "si": "1959 සිට ධර්මය, විනය සහ විද්‍යාව",
      "en": "Dhamma, discipline & knowledge since 1959",
      "ta": "1959 முதல் அறம், ஒழுக்கம், அறிவு",
      "tag": "span"
    },
    {
      "key": "text.header.001",
      "section": "header",
      "si": "විද්‍යාකීර්ති මහා පිරිවෙන",
