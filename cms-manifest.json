      "en": "Online Dhamma talks",
      "ta": "இணையவழி தர்ம உரைகள்",
      "tag": "strong"
    },
    {
      "key": "text.vision.006",
      "section": "vision",
      "si": "ඉදිරි සැලසුම",
      "en": "Planned",
      "ta": "எதிர்காலத் திட்டம்",
      "tag": "small"
    },
